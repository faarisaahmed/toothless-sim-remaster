# The film soundtrack, kept locally and never published.
#
# assets/audio/official_music/ is John Powell's HTTYD score, pulled out of
# custom Beat Saber maps. It is used for local playtesting only: this is a
# personal project and that music is not ours to redistribute, so it must not
# reach the GitHub repo or the Pages deploy. Everything in assets/audio/music/
# is the CC-BY set that ships instead — see its CREDITS.txt.
assets/audio/official_music/

# macOS
.DS_Store

# Blender's own auto-backup, written next to every .blend it saves
*.blend1

# Python bytecode from tools/props/
__pycache__/
*.pyc

# Regenerated by tools/props/render_sheet.py
assets/models/props/_preview/

# Generated by tools/render_check.py — a copy of index.html with a console
# recorder and a frame grabber spliced in.
_render_check.html
